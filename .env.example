# Optional EODHD credential. Base requirements enable price.py to read this file.
# Other tools can use the EODHD_API_KEY environment variable directly.
# A-share history: AKShare qfq -> Yahoo adjusted -> EODHD explicit adjusted close.
# Other markets: EODHD adjusted -> Yahoo adjusted. Providers can be unavailable.
# Never publish a real .env. The offline demo needs no key.
EODHD_API_KEY=your_eodhd_key_here
